{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ami-backend.onrender.com/:path*" },
    { "source": "/((?!api/|assets/|mascotas/|accesorios/|icons/|ilustraciones/).*)", "destination": "/index.html" }
  ]
}
